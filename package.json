{
  "name": "bulk-delete-for-chatgpt",
  "version": "1.1.0",
  "private": true,
  "description": "Select multiple ChatGPT chats in the sidebar and delete them in one action.",
  "author": "Nishant Gaharwar <iamnishantgaharwar@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/iamnishantgaharwar/bulk-delete-for-chatgpt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamnishantgaharwar/bulk-delete-for-chatgpt.git"
  },
  "bugs": {
    "url": "https://github.com/iamnishantgaharwar/bulk-delete-for-chatgpt/issues"
  },
  "keywords": [
    "chrome-extension",
    "chatgpt",
    "bulk-delete",
    "manifest-v3"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "zip": "npm run build && cd dist && zip -qr ../bulk-delete-for-chatgpt-v$npm_package_version.zip ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  }
}
